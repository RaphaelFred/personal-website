---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import ContactSection from '../components/ContactSection.astro';
import { withBase } from '../utils/paths';

const blogImages = {
  'building-clarity-from-complexity': {
    src: '/blog/ai-adoption-organisationen.webp',
    alt: 'Abstrakte Szene zu AI Adoption in Organisationen',
  },
  'fruehe-produktsignale-erkennen': {
    src: '/blog/user-innovation-mit-ki.webp',
    alt: 'Abstrakte Visualisierung zu User Innovation mit KI',
  },
  'experimente-richtig-framen': {
    src: '/blog/use-case-identifikation-ki.webp',
    alt: 'Abstrakte Visualisierung zur Identifikation von KI-Use-Cases',
  },
  'forecasting-unter-unsicherheit': {
    src: '/blog/strategische-datenanalyse-innovation.webp',
    alt: 'Abstrakte Visualisierung zu strategischer Datenanalyse und Unsicherheit',
  },
  'human-perspectives': {
    src: '/blog/ki-und-menschliche-perspektiven.webp',
    alt: 'Abstrakte Visualisierung unterschiedlicher menschlicher Perspektiven in KI-Systemen',
  },
};

const topics = [
  {
    title: 'AI & Data',
    detail:
      'Analytische Fragestellungen, Modellierung, KPI-Systeme und die Frage, wie aus Daten bessere Entscheidungen werden.',
    points: ['Forecasting und Modelllogik', 'Exploration relevanter Signale', 'Pragmatische Datennutzung'],
  },
  {
    title: 'Produkt und Innovation',
    detail:
      'Wie sich Nutzerverhalten lesen lässt, wo neue Chancen entstehen und wie man Innovations- und Produktfragen strukturiert.',
    points: ['Nutzer- und Produktverhalten', 'Hypothesen für neue Chancen', 'Priorisierung unter Unsicherheit'],
  },
  {
    title: 'Strategische Kommunikation',
    detail:
      'Wie Insights so aufbereitet werden, dass Teams, Stakeholder und Entscheider damit wirklich arbeiten können.',
    points: ['Klare Entscheidungsbilder', 'Storylines für Stakeholder', 'Übersetzung technischer Ergebnisse'],
  },
];

const trustItems = ['Miele', 'Arvato / Bertelsmann', 'Universität Bielefeld & Nova Universidade', '4. Platz SORDI.ai Wettbewerb'];

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

---

<Layout
  title="KI & Daten: Themen und Artikel | Raphael Fredebeul"
  description="Themen und Artikel von Raphael Fredebeul, Data Scientist aus Bielefeld, zu Datenanalyse, KI-Use-Cases, KI im Arbeitsalltag und Innovation."
>
  <main class="page" id="main-content">
    <SiteHeader current="ai-data" />

    <section class="hero">
      <div class="intro-main">
        <p class="kicker">Raphael Fredebeul</p>
        <h1>AI & <br>
          Data<br>
  </h1>
      </div>
    </section>

    <section class="trust-strip" aria-label="Erfahrung und Nachweise">
      <p class="kicker">Hintergrund</p>
      <div class="trust-list">
        {trustItems.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>

    <section class="section" id="themen">
      <div class="section-head">
        <div class="section-copy">
          <p class="kicker">Themenfelder</p>
          <h2>Womit ich mich beschäftige.</h2>
          <p class="section-text">
            Der gemeinsame Nenner ist fast immer derselbe: Komplexität reduzieren, ohne wichtige
            Nuancen zu verlieren.
          </p>
        </div>
      </div>

      <div class="card-grid">
        {topics.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
            <ul>
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="artikel">
      <div class="section-head">
        <div class="section-copy">
          <p class="kicker">Artikel</p>
          <h2>Notizen, Analysen und Beispiele aus meiner Arbeit mit Daten und AI.</h2>
        </div>
        <a class="section-link" href={withBase('/blog')}>Zum Archiv</a>
      </div>

      <div class="article-grid">
        {posts.map((post) => (
          <article class="article-card">
            <a class="article-image-link" href={withBase(`/blog/${post.slug}`)}>
              <img
                src={withBase(blogImages[post.slug]?.src ?? '/graphics/blog-panel.svg')}
                alt={blogImages[post.slug]?.alt ?? post.data.title}
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="article-copy">
              <p class="meta">
                {post.data.publishDate.toLocaleDateString('de-DE', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <h3>
                <a href={withBase(`/blog/${post.slug}`)}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <a class="article-link" href={withBase(`/blog/${post.slug}`)}>Artikel lesen</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <ContactSection copy="Wenn du über KI, Daten, Innovation oder eine konkrete Herausforderung sprechen möchtest, freue ich mich über eine Nachricht." />
  </main>
</Layout>

<style>
  .page {
    width: var(--page-container);
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .hero,
  .trust-strip,
  .section {
    border-top: 1px solid var(--line);
  }

  .section {
    padding: 2rem 0;
  }

  .trust-strip {
    display: grid;
    gap: 1rem;
    padding: 1.35rem 0;
  }

  .hero {
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: var(--subpage-hero-min-height);
    display: flex;
    align-items: start;
    padding: clamp(2.2rem, 5vw, 3rem) 0 2rem;
    border-bottom: 1px solid var(--line);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(244, 246, 243, 0.04), rgba(244, 246, 243, 0.12)),
      url('/images/hero-illustration.webp') center / cover no-repeat;
    opacity: 1;
    pointer-events: none;
    z-index: 0;
    filter: saturate(0.66) contrast(0.92);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(244, 246, 243, 0.74) 0%, rgba(244, 246, 243, 0.34) 34%, rgba(244, 246, 243, 0.08) 100%),
      linear-gradient(180deg, rgba(244, 246, 243, 0.1) 0%, rgba(244, 246, 243, 0.02) 36%, rgba(244, 246, 243, 0.18) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .intro-main {
    max-width: 40rem;
    width: var(--page-container);
    margin: 0 auto;
    position: relative;
    z-index: 1;
    padding-top: 0.2rem;
  }

  .kicker,
  .meta {
    margin: 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent-strong);
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin-top: 0;
  }

  h1 {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(3.3rem, 8.5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  h2 {
    margin: 0.55rem 0 0;
    max-width: 15ch;
    font-size: var(--title-lg);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  h3 {
    margin: 0;
    font-size: var(--title-md);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .section-text,
  .card p,
  .card li,
  .article-card p {
    color: var(--muted);
    line-height: 1.68;
    font-size: var(--text-md);
  }

  .button,
  .section-link {
    color: var(--text);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.2rem;
    padding: 0.88rem 1.3rem;
    border: 1px solid var(--text);
    border-radius: var(--radius-pill);
  }

  .button-primary {
    background: var(--text);
    color: var(--bg);
    box-shadow: var(--shadow-card);
  }

  .button-secondary {
    background: transparent;
  }

  .button:hover,
  .section-link:hover,
  .article-copy h3 a:hover,
  .article-link:hover {
    color: var(--accent-strong);
    border-color: currentColor;
    transform: translateY(-1px);
  }

  .button-primary:hover {
    color: var(--bg);
    background: var(--accent-strong);
  }

  .card,
  .article-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--panel);
    box-shadow: var(--shadow-card);
  }

  .card,
  .article-card {
    padding: 1.25rem;
  }

  .card ul {
    padding-left: 1.1rem;
    margin-bottom: 0;
  }

  .card li + li {
    margin-top: 0.55rem;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-copy {
    display: grid;
    gap: 0.2rem;
  }

  .section-text {
    margin-top: 0.8rem;
    max-width: 42rem;
  }

  .trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .trust-list span {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.62);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .card-grid,
  .article-grid {
    display: grid;
    gap: 1rem;
  }

  .card-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .article-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .card:hover,
  .article-card:hover,
  .article-image-link:hover img {
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }

  .card p,
  .article-card p {
    margin: 0.7rem 0 0;
  }

  .article-card {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr);
    gap: 1.4rem;
    align-items: start;
  }

  .article-image-link {
    display: block;
  }

  .article-image-link img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-xl) - 0.35rem);
    background: rgba(255, 255, 255, 0.7);
  }

  .article-copy {
    display: grid;
    align-content: start;
  }

  .article-link {
    display: inline-flex;
    align-items: center;
    margin-top: 1.1rem;
    color: var(--text);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 1180px) {
    .card-grid {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 980px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-card {
      grid-template-columns: 1fr;
    }

    .section-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero::after {
      background: linear-gradient(180deg, rgba(244, 246, 243, 0.84) 0%, rgba(244, 246, 243, 0.72) 56%, rgba(244, 246, 243, 0.46) 100%);
    }

  }

  @media (max-width: 720px) {
    h1,
    h2 {
      max-width: 100%;
    }

    .intro-main {
      width: var(--page-container);
    }

    .section {
      padding: 1.7rem 0;
    }

    .hero {
      min-height: var(--subpage-hero-min-height-mobile);
      padding-top: 1.6rem;
    }

    .button {
      width: 100%;
    }

    .card,
    .article-card {
      border-radius: var(--radius-lg);
    }

  }

</style>
