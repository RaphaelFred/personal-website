---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import { withBase } from '../utils/paths';
import { personSchema } from '../utils/person';

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const blogImages = {
  'building-clarity-from-complexity': {
    src: '/blog/ai-adoption-organisationen.jpg',
    alt: 'Abstrakte Szene zu AI Adoption in Organisationen',
  },
  'fruehe-produktsignale-erkennen': {
    src: '/blog/user-innovation-mit-ki.jpg',
    alt: 'Abstrakte Visualisierung zu User Innovation mit KI',
  },
  'experimente-richtig-framen': {
    src: '/blog/use-case-identifikation-ki.jpg',
    alt: 'Abstrakte Visualisierung zur Identifikation von KI-Use-Cases',
  },
  'forecasting-unter-unsicherheit': {
    src: '/blog/strategische-datenanalyse-innovation.jpg',
    alt: 'Abstrakte Visualisierung zu strategischer Datenanalyse und Unsicherheit',
  },
  'human-perspectives': {
    src: '/blog/ki-und-menschliche-perspektiven.jpg',
    alt: 'Abstrakte Visualisierung unterschiedlicher menschlicher Perspektiven in KI-Systemen',
  },
};

const focusAreas = [
  {
    title: 'Datenanalyse & Entscheidungen',
    detail: 'Wie Analysen so aufbereitet werden, dass Kernaussagen, Unsicherheiten und Entscheidungen klar werden.',
    slug: 'forecasting-unter-unsicherheit',
    image: '/images/schwerpunkte/tool-exploration.jpg',
    alt: 'Abstrakte Visualisierung zu Datenanalyse und Entscheidungen',
  },
  {
    title: 'KI-Use-Cases',
    detail: 'Welche KI-Anwendungen echten Nutzen stiften, eingeordnet nach Aufwand, Risiko und Umsetzbarkeit.',
    slug: 'experimente-richtig-framen',
    image: '/images/schwerpunkte/use-cases.jpg',
    alt: 'Abstrakte Visualisierung zur Identifikation von KI-Use-Cases',
  },
  {
    title: 'KI im Arbeitsalltag',
    detail: 'Wie Menschen KI nicht nur ausprobieren, sondern sinnvoll in ihre Arbeit integrieren.',
    slug: 'building-clarity-from-complexity',
    image: '/images/schwerpunkte/ki-schulungen.jpg',
    alt: 'Abstrakte Visualisierung zu KI im Arbeitsalltag',
  },
  {
    title: 'Innovation & Kreativität',
    detail: 'Wie KI, Daten und kreative Methoden neue Produktideen und ungewohnte Lösungsräume eröffnen.',
    slug: 'fruehe-produktsignale-erkennen',
    image: '/images/schwerpunkte/datenanalysen.jpg',
    alt: 'Abstrakte Visualisierung zu Innovation und Kreativität',
  },
];

const proofGroups = [
  {
    label: 'Wirtschaft & Industrie',
    logos: [
      { src: '/logos/miele.svg', alt: 'Miele' },
      { src: '/logos/arvato.svg', alt: 'Arvato' },
    ],
  },
  {
    label: 'Forschung',
    logos: [
      { src: '/logos/uni-bielefeld.svg', alt: 'Universität Bielefeld' },
      { src: '/logos/nova.png', alt: 'Nova Universidade' },
    ],
  },
  {
    label: 'Wettbewerb',
    logos: [{ src: '/logos/sordi-ai.webp', alt: 'SORDI.ai' }],
  },
];

const externalLinks = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/raphael-fredebeul-733605140/',
  },
  {
    label: 'SoundCloud',
    href: 'https://soundcloud.com/raphael-fredebeul',
  },
];

const linkedInUrl = 'https://www.linkedin.com/in/raphael-fredebeul-733605140/';

const contactMailto =
  'mailto:raphaeldc@gmx.de?subject=Hallo%20Raphael&body=Hallo%20Raphael,%0A%0A%0A%0AViele%20Gr%C3%BC%C3%9Fe';

const contactDestinations = [
  { label: 'AI & Data', href: '/ai-data', icon: 'grid' },
  { label: 'Texte', href: '/blog', icon: 'pen' },
  { label: 'E-Mail', href: contactMailto, icon: 'mail' },
  { label: 'LinkedIn', href: linkedInUrl, icon: 'linkedin' },
  { label: 'SoundCloud', href: 'https://soundcloud.com/raphael-fredebeul', icon: 'soundcloud' },
];
---

<Layout
  title="Raphael Fredebeul | Data Scientist aus Bielefeld"
  description="Raphael Fredebeul, Data Scientist aus Bielefeld: Gedanken und Artikel zu KI, Daten, Innovation und Kreativität."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema(Astro.site))} />
  <main class="page" id="main-content">
    <SiteHeader current="home" />

    <section class="intro-section" aria-label="Einleitung">
      <div class="intro-main">
        <p class="kicker">Raphael Fredebeul</p>
        <h1>KI. <br>
          Innovation. <br>
          Kreativität.</h1>
        <p class="intro-text">
          Ich bin Raphael, Data Scientist aus Bielefeld. Ich beschäftige mich damit, wie KI, Daten und Kreativität
          Menschen helfen, klarer zu denken und besser zu arbeiten.
        </p>
        <a class="intro-cta" href={linkedInUrl} target="_blank" rel="noreferrer">Lass uns vernetzen</a>
      </div>
    </section>

    <section class="list-section" aria-label="Schwerpunkte">
      <div class="focus-head">
        <p class="section-label">Schwerpunkte</p>
        <h2>Worin ich mich auskenne.</h2>
      </div>

      <div class="focus-grid">
        {focusAreas.map((item) => (
          <article class="focus-card">
            <a class="focus-card-link" href={withBase(`/blog/${item.slug}`)}>
              <img
                class="focus-card-image"
                src={withBase(item.image)}
                alt={item.alt}
                loading="lazy"
              />
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
              <span class="focus-card-more">Mein Artikel dazu →</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="proof-strip" aria-label="Erfahrung und Nachweise">
      <p class="section-label">Stationen aus Praxis, Forschung und Wettbewerb</p>
      <div class="proof-groups">
        {proofGroups.map((group) => (
          <div class="proof-group">
            <p class="proof-category">{group.label}</p>
            <div class="proof-list">
              {group.logos.map((item) => (
                <span class="proof-logo">
                  <img src={withBase(item.src)} alt={item.alt} loading="lazy" decoding="async" />
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="list-section" aria-label="Texte">
      <div class="article-section-head">
        <p class="section-label">Texte</p>
        <h2>Aktuelle Notizen und Artikel.</h2>
      </div>

      <div class="article-grid">
        {blogPosts.map((post) => (
          <article class="article-card">
            <a class="article-image-link" href={withBase(`/blog/${post.slug}`)}>
              <img
                src={withBase(blogImages[post.slug]?.src ?? '/graphics/blog-panel.svg')}
                alt={blogImages[post.slug]?.alt ?? post.data.title}
                loading="lazy"
              />
            </a>
            <h3>
              <a href={withBase(`/blog/${post.slug}`)}>{post.data.title}</a>
            </h3>
            <p class="article-summary">{post.data.description}</p>
            <a class="article-link" href={withBase(`/blog/${post.slug}`)}>Read More →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="contact-showcase" id="kontakt" aria-label="Kontakt">
      <div class="contact-hero">
        <div class="contact-card">
          <h2>Schreib mir gern.</h2>
          <p class="contact-copy">
            Ob KI, Daten, Innovation oder einfach ein guter Gedanke: Ich freue mich über Austausch und neue Kontakte.
          </p>
          <a class="contact-mail-link" href={contactMailto}>Kontakt</a>
        </div>
      </div>

      <div class="contact-icons" aria-label="Bereiche und Profile">
        {contactDestinations.map((item) => (
          <a
            class="icon-tile"
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
            aria-label={item.label}
            title={item.label}
          >
            {item.icon === 'grid' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z" />
              </svg>
            ) : item.icon === 'wave' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 12c2.4 0 2.4-6 4.8-6s2.4 12 4.8 12S15 9 17.4 9 19.8 15 22 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            ) : item.icon === 'pen' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m4 16.5 9.9-9.9 3.5 3.5-9.9 9.9L4 20l.5-3.5ZM14.9 5.6l1.7-1.7a1.9 1.9 0 0 1 2.7 0l1 1a1.9 1.9 0 0 1 0 2.7l-1.7 1.7-3.7-3.7Z" />
              </svg>
            ) : item.icon === 'mail' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6h16v12H4V6Zm0 1.2 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            ) : item.icon === 'linkedin' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.94 8.5V19H3.5V8.5h3.44ZM7.16 5.26c0 1-.74 1.74-1.94 1.74A1.72 1.72 0 0 1 3.32 5.3c0-1 .76-1.76 1.92-1.76s1.88.74 1.92 1.72ZM20.68 12.58V19h-3.42v-6.02c0-1.52-.54-2.56-1.9-2.56-1.04 0-1.66.7-1.94 1.38-.1.24-.12.58-.12.92V19H9.88s.04-9.74 0-10.5h3.42v1.48c.45-.7 1.26-1.7 3.08-1.7 2.24 0 3.92 1.46 3.92 4.6Z" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.37 13.44a2.06 2.06 0 0 0 2.05 2.06h11.95a1.58 1.58 0 1 0 0-3.16h-.59a4.24 4.24 0 0 0-8.13-1.66 2.75 2.75 0 0 0-1.08-.22 2.73 2.73 0 0 0-2.63 1.97 2.05 2.05 0 0 0-1.57 2.01Zm14.72 4.1c.24 0 .43.19.43.42v.34a.43.43 0 0 1-.43.43H5.74a.43.43 0 0 1-.43-.43v-.34c0-.23.19-.42.43-.42h13.35Zm-11.4 2.15c.23 0 .42.19.42.42v.35a.42.42 0 0 1-.42.42H5.74a.42.42 0 0 1-.43-.42v-.35c0-.23.19-.42.43-.42h1.95Zm3.04 0c.23 0 .42.19.42.42v.35a.42.42 0 0 1-.42.42H8.78a.42.42 0 0 1-.42-.42v-.35c0-.23.19-.42.42-.42h1.95Zm3.03 0c.24 0 .43.19.43.42v.35a.43.43 0 0 1-.43.42h-1.95a.42.42 0 0 1-.42-.42v-.35c0-.23.19-.42.42-.42h1.95Zm3.03 0c.24 0 .43.19.43.42v.35a.43.43 0 0 1-.43.42h-1.95a.42.42 0 0 1-.42-.42v-.35c0-.23.19-.42.42-.42h1.95Z" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </section>
  </main>

</Layout>

<style>
  .page {
    width: var(--page-container);
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .intro-section,
  .proof-strip,
  .list-section,
  .contact-showcase {
    border-top: 1px solid var(--line);
  }

  .intro-section {
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: var(--hero-min-height);
    display: flex;
    align-items: start;
    padding: clamp(2.2rem, 5vw, 3rem) 0 2rem;
    border-bottom: 1px solid var(--line);
  }

  .list-section {
    padding: 4.5rem 0;
  }

  .proof-strip {
    display: grid;
    justify-items: center;
    gap: 1.45rem;
    padding: 2.8rem 0;
  }

  .intro-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(244, 246, 243, 0.04), rgba(244, 246, 243, 0.12)),
      url('/images/hero-illustration.jpg') center / cover no-repeat;
    opacity: 1;
    pointer-events: none;
    z-index: 0;
    filter: saturate(0.66) contrast(0.92);
  }

  .intro-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(244, 246, 243, 0.74) 0%, rgba(244, 246, 243, 0.34) 34%, rgba(244, 246, 243, 0.08) 100%),
      linear-gradient(180deg, rgba(244, 246, 243, 0.1) 0%, rgba(244, 246, 243, 0.02) 36%, rgba(244, 246, 243, 0.18) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .intro-main {
    max-width: 40rem;
    width: var(--page-container);
    margin: 0 auto;
    position: relative;
    z-index: 1;
    padding-top: 0.2rem;
  }

  .intro-cta {
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    margin-top: 1.8rem;
    padding: 0 1.4rem;
    border: 1px solid var(--text);
    background: var(--text);
    color: #fff;
    text-decoration: none;
  }

  .intro-cta:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .kicker,
  .section-label {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(3.3rem, 8.5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  h2 {
    margin: 0.3rem 0 0;
    max-width: 12ch;
    font-size: clamp(1.9rem, 3.3vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.25rem, 1.9vw, 1.55rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .intro-text {
    color: var(--muted);
    line-height: 1.72;
    margin: 1.45rem 0 0;
    max-width: 34rem;
    font-size: clamp(1.08rem, 1.8vw, 1.26rem);
  }

  .proof-groups {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    width: min(100%, 60rem);
  }

  .proof-group {
    display: grid;
    justify-items: center;
    gap: 0.65rem;
  }

  .proof-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }

  .proof-logo {
    width: 10.4rem;
    display: grid;
    align-items: center;
    align-content: center;
    justify-content: center;
    min-height: 4.35rem;
    padding: 0.9rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.62);
  }

  .proof-category {
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  .proof-logo img {
    width: auto;
    max-width: min(8rem, 82%);
    height: 1.65rem;
    object-fit: contain;
    filter: grayscale(1) saturate(0) opacity(0.52);
  }

  .focus-head {
    margin-bottom: 2rem;
  }

  .focus-head h2 {
    max-width: none;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem;
  }

  .focus-card-link {
    display: block;
    color: var(--text);
  }

  .focus-card-image {
    width: 100%;
    height: clamp(13rem, 22vw, 17.5rem);
    object-fit: cover;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.7);
  }

  .focus-card h3 {
    margin-top: 1rem;
  }

  .focus-card p {
    margin: 0.7rem 0 0;
    color: var(--muted);
    line-height: 1.68;
    font-size: 1rem;
  }

  .focus-card-more {
    display: inline-flex;
    margin-top: 1rem;
  }

  .focus-card-link:hover h3,
  .focus-card-link:hover .focus-card-more {
    color: var(--accent-strong);
  }

  .article-item h3 {
    margin-top: 0.3rem;
    max-width: 24rem;
  }

  .article-item h3 a {
    color: var(--text);
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.25rem;
  }

  .article-section-head {
    margin-bottom: 2rem;
  }

  .article-section-head h2 {
    max-width: none;
  }

  .article-card {
    display: block;
  }

  .article-image-link {
    display: block;
    color: var(--text);
  }

  .article-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.72);
  }

  .article-card h3 {
    margin-top: 1rem;
    max-width: none;
  }

  .article-card h3 a,
  .article-link {
    color: var(--text);
  }

  .article-summary {
    margin: 0.7rem 0 0;
    color: var(--muted);
    line-height: 1.68;
    font-size: 1rem;
  }

  .article-link {
    display: inline-flex;
    align-items: center;
    margin-top: 1rem;
  }

  .article-card:hover h3 a,
  .article-card:hover .article-link {
    color: var(--accent-strong);
  }

  .contact-showcase {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 4.5rem 0 0;
  }

  .contact-hero {
    position: relative;
    overflow: hidden;
    min-height: 34rem;
    display: grid;
    place-items: center;
    padding: 2rem;
    background:
      linear-gradient(180deg, rgba(244, 246, 243, 0.18), rgba(244, 246, 243, 0.24)),
      url('/images/contact-illustration.jpg') center / cover no-repeat;
  }

  .contact-card {
    width: min(100%, 46rem);
    padding: clamp(2rem, 5vw, 4rem);
    background: rgba(248, 249, 246, 0.93);
    border: 1px solid rgba(23, 25, 20, 0.08);
    box-shadow: 0 20px 50px rgba(23, 25, 20, 0.08);
    text-align: center;
  }

  .contact-card h2 {
    margin-left: auto;
    margin-right: auto;
    max-width: 13ch;
  }

  .contact-copy {
    margin: 1rem auto 0;
    max-width: 30rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .contact-mail-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.7rem;
    margin-top: 2rem;
    padding: 0 1.5rem;
    border: 1px solid var(--text);
    background: var(--text);
    color: #fff;
    cursor: pointer;
    text-decoration: none;
  }

  .contact-mail-link:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .contact-icons {
    width: var(--page-container);
    margin-left: auto;
    margin-right: auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.35rem;
    padding: 1.35rem 0 0;
    border-top: 1px solid var(--line);
  }

  .icon-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--text);
  }

  .icon-tile svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .icon-tile:hover {
    color: var(--accent-strong);
    border-color: currentColor;
    transform: translateY(-1px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .intro-section {
      min-height: var(--hero-min-height-mobile);
      align-items: start;
    }

    .intro-section::before {
      opacity: 1;
    }

    .intro-section::after {
      background: linear-gradient(180deg, rgba(244, 246, 243, 0.58) 0%, rgba(244, 246, 243, 0.24) 42%, rgba(244, 246, 243, 0.18) 100%);
    }

    .intro-main {
      max-width: none;
    }

    .focus-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .proof-list {
      width: auto;
    }

    .contact-mail-link {
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .page {
      padding-top: 0.6rem;
      padding-bottom: 3rem;
    }

    .intro-main {
      width: var(--page-container);
    }

    h1,
    h2 {
      max-width: 100%;
    }

    .intro-section {
      padding-top: 1.6rem;
    }

    .contact-hero {
      min-height: 28rem;
      padding: 1rem;
    }

    .contact-icons {
      width: var(--page-container);
    }

    .contact-card {
      padding: 1.5rem;
    }

    .proof-groups,
    .proof-group,
    .proof-list {
      width: 100%;
    }

    .proof-logo {
