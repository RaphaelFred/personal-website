---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import ContactSection from '../components/ContactSection.astro';
import { withBase } from '../utils/paths';
import { personSchema } from '../utils/person';

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const blogImages = {
  'building-clarity-from-complexity': {
    src: '/blog/ai-adoption-organisationen.webp',
    alt: 'Abstrakte Szene zu AI Adoption in Organisationen',
  },
  'fruehe-produktsignale-erkennen': {
    src: '/blog/user-innovation-mit-ki.webp',
    alt: 'Abstrakte Visualisierung zu User Innovation mit KI',
  },
  'experimente-richtig-framen': {
    src: '/blog/use-case-identifikation-ki.webp',
    alt: 'Abstrakte Visualisierung zur Identifikation von KI-Use-Cases',
  },
  'forecasting-unter-unsicherheit': {
    src: '/blog/strategische-datenanalyse-innovation.webp',
    alt: 'Abstrakte Visualisierung zu strategischer Datenanalyse und Unsicherheit',
  },
  'human-perspectives': {
    src: '/blog/ki-und-menschliche-perspektiven.webp',
    alt: 'Abstrakte Visualisierung unterschiedlicher menschlicher Perspektiven in KI-Systemen',
  },
};

const focusAreas = [
  {
    title: 'Datenanalyse & Entscheidungen',
    detail: 'Wie Analysen so aufbereitet werden, dass Kernaussagen, Unsicherheiten und Entscheidungen klar werden.',
    slug: 'forecasting-unter-unsicherheit',
    image: '/images/schwerpunkte/tool-exploration.webp',
    alt: 'Abstrakte Visualisierung zu Datenanalyse und Entscheidungen',
  },
  {
    title: 'KI-Use-Cases',
    detail: 'Welche KI-Anwendungen echten Nutzen stiften, eingeordnet nach Aufwand, Risiko und Umsetzbarkeit.',
    slug: 'experimente-richtig-framen',
    image: '/images/schwerpunkte/use-cases.webp',
    alt: 'Abstrakte Visualisierung zur Identifikation von KI-Use-Cases',
  },
  {
    title: 'KI im Arbeitsalltag',
    detail: 'Wie Menschen KI nicht nur ausprobieren, sondern sinnvoll in ihre Arbeit integrieren.',
    slug: 'building-clarity-from-complexity',
    image: '/images/schwerpunkte/ki-schulungen.webp',
    alt: 'Abstrakte Visualisierung zu KI im Arbeitsalltag',
  },
  {
    title: 'Innovation & Kreativität',
    detail: 'Wie KI, Daten und kreative Methoden neue Produktideen und ungewohnte Lösungsräume eröffnen.',
    slug: 'fruehe-produktsignale-erkennen',
    image: '/images/schwerpunkte/datenanalysen.webp',
    alt: 'Abstrakte Visualisierung zu Innovation und Kreativität',
  },
];

const proofGroups = [
  {
    label: 'Wirtschaft & Industrie',
    logos: [
      { src: '/logos/miele.svg', alt: 'Miele' },
      { src: '/logos/arvato.svg', alt: 'Arvato' },
    ],
  },
  {
    label: 'Forschung',
    logos: [
      { src: '/logos/uni-bielefeld.svg', alt: 'Universität Bielefeld' },
      { src: '/logos/nova.png', alt: 'Nova Universidade' },
    ],
  },
  {
    label: 'Wettbewerb',
    logos: [{ src: '/logos/sordi-ai.webp', alt: 'SORDI.ai' }],
  },
];

const linkedInUrl = 'https://www.linkedin.com/in/raphael-fredebeul-733605140/';

---

<Layout
  title="Raphael Fredebeul | Data Scientist aus Bielefeld"
  description="Raphael Fredebeul, Data Scientist aus Bielefeld: Gedanken und Artikel zu KI, Daten, Innovation und Kreativität."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema(Astro.site))} />
  <main class="page" id="main-content">
    <SiteHeader current="home" />

    <section class="intro-section" aria-label="Einleitung">
      <div class="intro-main">
        <p class="kicker">Raphael Fredebeul</p>
        <h1>KI. <br>
          Innovation. <br>
          Kreativität.</h1>
        <p class="intro-text">
          Ich bin Raphael, Data Scientist aus Bielefeld. Ich beschäftige mich damit, wie KI, Daten und Kreativität
          Menschen helfen, klarer zu denken und besser zu arbeiten.
        </p>
        <a class="intro-cta" href={linkedInUrl} target="_blank" rel="noreferrer">Lass uns vernetzen</a>
      </div>
    </section>

    <section class="list-section" aria-label="Schwerpunkte">
      <div class="focus-head">
        <p class="section-label">Schwerpunkte</p>
        <h2>Worin ich mich auskenne.</h2>
      </div>

      <div class="focus-grid">
        {focusAreas.map((item) => (
          <article class="focus-card">
            <a class="focus-card-link" href={withBase(`/blog/${item.slug}`)}>
              <img
                class="focus-card-image"
                src={withBase(item.image)}
                alt={item.alt}
                width="1000"
                height="625"
                loading="lazy"
                decoding="async"
              />
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
              <span class="focus-card-more">Mein Artikel dazu →</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="proof-strip" aria-label="Erfahrung und Nachweise">
      <p class="section-label">Stationen aus Praxis, Forschung und Wettbewerb</p>
      <div class="proof-groups">
        {proofGroups.map((group) => (
          <div class="proof-group">
            <p class="proof-category">{group.label}</p>
            <div class="proof-list">
              {group.logos.map((item) => (
                <span class="proof-logo">
                  <img src={withBase(item.src)} alt={item.alt} loading="lazy" decoding="async" />
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="list-section" aria-label="Texte">
      <div class="article-section-head">
        <p class="section-label">Texte</p>
        <h2>Aktuelle Notizen und Artikel.</h2>
      </div>

      <div class="article-grid">
        {blogPosts.map((post) => (
          <article class="article-card">
            <a class="article-image-link" href={withBase(`/blog/${post.slug}`)}>
              <img
                src={withBase(blogImages[post.slug]?.src ?? '/graphics/blog-panel.svg')}
                alt={blogImages[post.slug]?.alt ?? post.data.title}
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </a>
            <h3>
              <a href={withBase(`/blog/${post.slug}`)}>{post.data.title}</a>
            </h3>
            <p class="article-summary">{post.data.description}</p>
            <a class="article-link" href={withBase(`/blog/${post.slug}`)}>Weiterlesen →</a>
          </article>
        ))}
      </div>
    </section>

    <ContactSection />
  </main>

</Layout>

<style>
  .page {
    width: var(--page-container);
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .intro-section,
  .proof-strip,
  .list-section {
    border-top: 1px solid var(--line);
  }

  .intro-section {
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: var(--hero-min-height);
    display: flex;
    align-items: start;
    padding: clamp(2.2rem, 5vw, 3rem) 0 2rem;
    border-bottom: 1px solid var(--line);
  }

  .list-section {
    padding: 4.5rem 0;
  }

  .proof-strip {
    display: grid;
    justify-items: center;
    gap: 1.45rem;
    padding: 2.8rem 0;
  }

  .intro-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(244, 246, 243, 0.04), rgba(244, 246, 243, 0.12)),
      url('/images/hero-illustration.webp') center / cover no-repeat;
    opacity: 1;
    pointer-events: none;
    z-index: 0;
    filter: saturate(0.66) contrast(0.92);
  }

  .intro-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(244, 246, 243, 0.74) 0%, rgba(244, 246, 243, 0.34) 34%, rgba(244, 246, 243, 0.08) 100%),
      linear-gradient(180deg, rgba(244, 246, 243, 0.1) 0%, rgba(244, 246, 243, 0.02) 36%, rgba(244, 246, 243, 0.18) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .intro-main {
    max-width: 40rem;
    width: var(--page-container);
    margin: 0 auto;
    position: relative;
    z-index: 1;
    padding-top: 0.2rem;
  }

  .intro-cta {
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    margin-top: 1.8rem;
    padding: 0 1.4rem;
    border: 1px solid var(--text);
    background: var(--text);
    color: #fff;
    text-decoration: none;
  }

  .intro-cta:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .kicker,
  .section-label {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(3.3rem, 8.5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  h2 {
    margin: 0.3rem 0 0;
    max-width: 12ch;
    font-size: clamp(1.9rem, 3.3vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.25rem, 1.9vw, 1.55rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .intro-text {
    color: var(--muted);
    line-height: 1.72;
    margin: 1.45rem 0 0;
    max-width: 34rem;
    font-size: clamp(1.08rem, 1.8vw, 1.26rem);
  }

  .proof-groups {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    width: min(100%, 60rem);
  }

  .proof-group {
    display: grid;
    justify-items: center;
    gap: 0.65rem;
  }

  .proof-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }

  .proof-logo {
    width: 10.4rem;
    display: grid;
    align-items: center;
    align-content: center;
    justify-content: center;
    min-height: 4.35rem;
    padding: 0.9rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.62);
  }

  .proof-category {
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  .proof-logo img {
    width: auto;
    max-width: min(8rem, 82%);
    height: 1.65rem;
    object-fit: contain;
    filter: grayscale(1) saturate(0) opacity(0.72);
  }

  .focus-head {
    margin-bottom: 2rem;
  }

  .focus-head h2 {
    max-width: none;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem;
  }

  .focus-card-link {
    display: block;
    color: var(--text);
  }

  .focus-card-image {
    width: 100%;
    height: clamp(13rem, 22vw, 17.5rem);
    object-fit: cover;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.7);
  }

  .focus-card h3 {
    margin-top: 1rem;
  }

  .focus-card p {
    margin: 0.7rem 0 0;
    color: var(--muted);
    line-height: 1.68;
    font-size: 1rem;
  }

  .focus-card-more {
    display: inline-flex;
    margin-top: 1rem;
  }

  .focus-card-link:hover h3,
  .focus-card-link:hover .focus-card-more {
    color: var(--accent-strong);
  }

  .article-item h3 {
    margin-top: 0.3rem;
    max-width: 24rem;
  }

  .article-item h3 a {
    color: var(--text);
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.25rem;
  }

  .article-section-head {
    margin-bottom: 2rem;
  }

  .article-section-head h2 {
    max-width: none;
  }

  .article-card {
    display: block;
  }

  .article-image-link {
    display: block;
    color: var(--text);
  }

  .article-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.72);
  }

  .article-card h3 {
    margin-top: 1rem;
    max-width: none;
  }

  .article-card h3 a,
  .article-link {
    color: var(--text);
  }

  .article-summary {
    margin: 0.7rem 0 0;
    color: var(--muted);
    line-height: 1.68;
    font-size: 1rem;
  }

  .article-link {
    display: inline-flex;
    align-items: center;
    margin-top: 1rem;
  }

  .article-card:hover h3 a,
  .article-card:hover .article-link {
    color: var(--accent-strong);
  }

  @media (max-width: 900px) {
    .intro-section {
      min-height: var(--hero-min-height-mobile);
      align-items: start;
    }

    .intro-section::before {
      opacity: 1;
    }

    .intro-section::after {
      background: linear-gradient(180deg, rgba(244, 246, 243, 0.58) 0%, rgba(244, 246, 243, 0.24) 42%, rgba(244, 246, 243, 0.18) 100%);
    }

    .intro-main {
      max-width: none;
    }

    .focus-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .proof-list {
      width: auto;
    }

  }

  @media (max-width: 720px) {
    .page {
      padding-top: 0.6rem;
      padding-bottom: 3rem;
    }

    .intro-main {
      width: var(--page-container);
    }

    h1,
    h2 {
      max-width: 100%;
    }

    .intro-section {
      padding-top: 1.6rem;
    }

    .proof-groups,
    .proof-group,
    .proof-list {
      width: 100%;
    }

    .proof-logo {
      width: 100%;
    }

  }
</style>
