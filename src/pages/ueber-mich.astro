---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ContactSection from '../components/ContactSection.astro';
import { withBase } from '../utils/paths';

const cvPoints = [
  'Data Scientist mit Fokus auf AI, Datenanalyse und Innovation.',
  'Arbeit an der Schnittstelle von analytischer Präzision, strategischer Einordnung und praktischer Umsetzbarkeit.',
  'Interesse daran, wie neue Technologien sinnvoll in reale Arbeitsprozesse übersetzt werden.',
];

const evidenceGroups = [
  {
    label: 'Praxis',
    title: 'Wirtschaft & Industrie',
    items: [
      {
        title: 'Miele',
        detail:
          'Daten- und AI-Fragestellungen in einem industriellen Kontext, in dem analytische Arbeit anschlussfähig und praktisch nutzbar sein muss.',
      },
      {
        title: 'Arvato / Bertelsmann',
        detail:
          'Erfahrung mit datengetriebenen Themen in Konzern- und Organisationsumfeldern, in denen Analyse, Umsetzung und Kommunikation zusammenkommen.',
      },
    ],
  },
  {
    label: 'Forschung',
    title: 'Akademischer Hintergrund',
    items: [
      {
        title: 'Universität Bielefeld',
        detail: 'Analytische Ausbildung und wissenschaftliches Arbeiten als Grundlage für strukturierte Datenarbeit.',
      },
      {
        title: 'Nova Universidade',
        detail: 'Internationale Perspektive auf Technologie, Organisation und die Einordnung komplexer Fragestellungen.',
      },
    ],
  },
  {
    label: 'Wettbewerb',
    title: 'SORDI.ai',
    items: [
      {
        title: '4. Platz im AI Wettbewerb',
        detail: 'Teilnahme am SORDI.ai AI-Wettbewerb mit Platzierung unter den besten Einreichungen.',
      },
    ],
  },
];

---

<Layout
  title="Über mich | Raphael Fredebeul"
  description="Raphael Fredebeul, Data Scientist aus Bielefeld: Hintergrund in Industrie, Forschung und KI-Wettbewerben, mit Fokus auf KI, Datenanalyse und Innovation."
>
  <main class="page" id="main-content">
    <SiteHeader current="about" />

    <section class="intro-section" aria-label="Einleitung">
      <div class="intro-main">
        <p class="kicker">Raphael Fredebeul</p>
        <h1>Über <br>
          mich</h1>
      </div>
    </section>

    <section class="section" aria-label="Kurzprofil">
      <div class="profile-grid">
        <figure class="profile-image">
          <img
            src={withBase('/images/raphael-portrait.jpeg')}
            alt="Raphael Fredebeul draußen vor einer Küstenlandschaft"
            width="1050"
            height="1400"
            loading="eager"
            decoding="async"
          />
        </figure>

        <div class="profile-copy">
          <div class="section-copy">
            <p class="kicker">Wofür ich stehe</p>
            <h2>Bessere Entscheidungen mit KI und Daten.</h2>
            <p class="section-text">
              Die eigentliche Frage ist nicht, ob wir KI nutzen. Die Frage ist, ob sie unser Denken besser macht.
              Ich verbinde Data Science, AI Enablement und strategische Problemklärung, um aus Komplexität klarere Fragen,
              bessere Entscheidungen und konkrete nächste Schritte zu entwickeln.
            </p>
          </div>

          <div class="cv-list">
            {cvPoints.map((item, index) => (
              <div class="cv-item">
                <span class="cv-index">{String(index + 1).padStart(2, '0')}</span>
                <p>{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-label="Stationen und Nachweise">
      <div class="evidence-section-grid">
        <div class="section-copy">
          <p class="kicker">Stationen & Nachweise</p>
          <h2>Kontexte, aus denen meine Arbeit kommt.</h2>
          <p class="section-text">
            Meine Perspektive entsteht aus praktischer Datenarbeit, akademischem Hintergrund
            und Wettbewerbserfahrung im AI-Umfeld.
          </p>
        </div>

        <div class="evidence-groups">
          {evidenceGroups.map((group) => (
            <section class="evidence-group" aria-label={group.title}>
              <div class="evidence-group-head">
                <p class="evidence-label">{group.label}</p>
                <h3>{group.title}</h3>
              </div>
              <div class="evidence-items">
                {group.items.map((item) => (
                  <article class="evidence-item">
                    <h4>{item.title}</h4>
                    <p>{item.detail}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <ContactSection />
  </main>
</Layout>

<style>
  .page {
    width: var(--page-container);
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .intro-section,
  .section {
    border-top: 1px solid var(--line);
  }

  .section {
    padding: 4.5rem 0;
    scroll-margin-top: 1.5rem;
  }

  .intro-section {
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: var(--subpage-hero-min-height);
    display: flex;
    align-items: start;
    padding: clamp(2.2rem, 5vw, 3rem) 0 2rem;
    border-bottom: 1px solid var(--line);
  }

  .intro-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(244, 246, 243, 0.04), rgba(244, 246, 243, 0.12)),
      url('/images/hero-illustration.webp') center / cover no-repeat;
    opacity: 1;
    pointer-events: none;
    z-index: 0;
    filter: saturate(0.66) contrast(0.92);
  }

  .intro-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(244, 246, 243, 0.74) 0%, rgba(244, 246, 243, 0.34) 34%, rgba(244, 246, 243, 0.08) 100%),
      linear-gradient(180deg, rgba(244, 246, 243, 0.1) 0%, rgba(244, 246, 243, 0.02) 36%, rgba(244, 246, 243, 0.18) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .intro-main {
    max-width: 40rem;
    width: var(--page-container);
    margin: 0 auto;
    position: relative;
    z-index: 1;
    padding-top: 0.2rem;
  }

  .section-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .evidence-section-grid {
    display: grid;
    gap: clamp(1.6rem, 4vw, 3rem);
  }

  .evidence-section-grid .section-copy {
    max-width: 46rem;
  }

  .evidence-section-grid h2 {
    max-width: 16ch;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1fr);
    gap: clamp(1.6rem, 5vw, 4rem);
    align-items: stretch;
  }

  .profile-copy {
    display: grid;
    gap: 1.4rem;
    align-content: space-between;
    align-self: stretch;
  }

  .profile-image {
    position: relative;
    overflow: hidden;
    margin: 0;
    min-height: 30rem;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--panel);
    box-shadow: var(--shadow-card);
  }

  .profile-image::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(244, 246, 243, 0.02), rgba(23, 25, 20, 0.14)),
      linear-gradient(90deg, rgba(244, 246, 243, 0.16), transparent 42%);
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 36%;
    filter: saturate(0.9) contrast(0.96);
  }

  .kicker {
    margin: 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent-strong);
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin-top: 0;
  }

  h1 {
    margin: 0.55rem 0 0;
    max-width: 11ch;
    font-size: var(--title-xl);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  h2 {
    margin: 0.45rem 0 0;
    max-width: 14ch;
    font-size: var(--title-lg);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  h3 {
    margin: 0;
    font-size: var(--title-md);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .section-text,
  .cv-item p {
    color: var(--muted);
    line-height: 1.7;
    font-size: var(--text-md);
  }

  .section-text {
    margin: 1rem 0 0;
    max-width: 34rem;
  }

  .cv-list {
    display: grid;
    gap: 1rem;
  }

  .cv-list {
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .cv-item {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }

  .cv-index {
    color: var(--accent-strong);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    line-height: 1.7;
  }

  .cv-item p {
    margin: 0;
  }

  .evidence-groups {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .evidence-group {
    display: grid;
    grid-template-columns: minmax(170px, 0.42fr) minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2.5rem);
    padding: 1.45rem 0;
    border-bottom: 1px solid var(--line);
  }

  .evidence-group-head {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }

  .evidence-label {
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .evidence-group h3 {
    font-size: clamp(1.22rem, 1.8vw, 1.55rem);
    line-height: 1.08;
  }

  .evidence-items {
    display: grid;
    gap: 1.05rem;
  }

  .evidence-item {
    display: grid;
    gap: 0.45rem;
    max-width: 42rem;
  }

  .evidence-item h4 {
    margin: 0;
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    line-height: 1.18;
  }

  .evidence-item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.58;
  }

  @media (max-width: 900px) {
    .profile-grid,
    .section-grid {
      grid-template-columns: 1fr;
    }

    .profile-copy {
      align-content: start;
    }

    .profile-image {
      min-height: 0;
      max-height: 42rem;
      width: min(100%, 30rem);
    }

    .intro-section {
      min-height: var(--subpage-hero-min-height-mobile);
      align-items: start;
    }

    .intro-section::before {
      opacity: 1;
    }

    .intro-section::after {
      background: linear-gradient(180deg, rgba(244, 246, 243, 0.58) 0%, rgba(244, 246, 243, 0.24) 42%, rgba(244, 246, 243, 0.18) 100%);
    }

  }

  @media (max-width: 720px) {
    .page {
      padding-top: 0.6rem;
      padding-bottom: 3rem;
    }

    .intro-main {
      width: var(--page-container);
    }

    h1,
    h2 {
      max-width: 100%;
    }

    .cv-item {
      grid-template-columns: 2.6rem minmax(0, 1fr);
      gap: 0.8rem;
    }

    .intro-section {
      padding-top: 1.6rem;
    }

    .profile-image {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-lg);
    }

    .evidence-group {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding: 1.25rem 0;
    }

    .evidence-group-head {
      gap: 0.25rem;
    }

  }
</style>
